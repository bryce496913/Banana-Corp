          "payload": {
            "type": "email",
            "data": {
              "sender": "D. · forwarded internal correspondence",
              "recipients": [
                "Internal Review"
              ],
              "blocks": [
                {
                  "kind": "paragraph",
                  "text": "The launch summary says the adaptive interface stays within the preferences a user selects. The current review does not establish that for every case we tested."
                },
                {
                  "kind": "paragraph",
                  "text": "I asked for the unresolved cases to stay in the record. The copy circulating for sign-off now treats them as closed, but I have not seen a corresponding review."
                },
                {
                  "kind": "paragraph",
                  "text": "Please compare the review notes with the public wording before approving the summary. This thread was not intended for external distribution."
                },
                {
                  "kind": "paragraph",
                  "text": "— D."
                }
              ]
            }
          },
